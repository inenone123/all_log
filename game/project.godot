; Engine configuration file.
; SPEC.md 2章の設定に従う（viewport 1920x1080 / stretch=canvas_items,expand / linear filter）。
; 生成物であっても .godot/ は VCS 管理外（game/.gitignore 参照）。

config_version=5

[application]

config/name="ActionAdventure (Vertical Slice)"
run/main_scene="res://scenes/rooms/Room_01.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

